% theme.sty
\ProvidesPackage{theme}

% ============================================================================
% Package imports
% ============================================================================
\RequirePackage{parskip}
\RequirePackage{setspace}
\RequirePackage{xspace}
\RequirePackage{xcolor}
\RequirePackage{enumitem}
\RequirePackage{listings}
\RequirePackage{hyperref}
\RequirePackage[framemethod=TikZ]{mdframed}
\RequirePackage{titletoc}
\RequirePackage{titlesec}
\RequirePackage{amsthm}
\RequirePackage{mathtools}
\RequirePackage{fontspec}
\RequirePackage{unicode-math}

% ============================================================================
% Color definitions
% ============================================================================
\definecolor{materialBlue}{HTML}{2196F3}
\definecolor{materialIndigo}{HTML}{3F51B5}
\definecolor{materialGreen}{HTML}{4CAF50}
\definecolor{materialOrange}{HTML}{FF9800}
\definecolor{materialRed}{HTML}{F44336}
\definecolor{materialGrey}{HTML}{9E9E9E}
\definecolor{materialLightGrey}{HTML}{F5F5F5}
\definecolor{materialDarkGrey}{HTML}{616161}

% Darker shades for text on white, so it reads at 4.5:1 or more (WCAG AA).
% materialOrangeText is Material Deep Orange 900; materialGreenText is Green 800.
\definecolor{materialOrangeText}{HTML}{BF360C}
\definecolor{materialGreenText}{HTML}{2E7D32}

% ============================================================================
% Font configuration
% ============================================================================
\defaultfontfeatures{Ligatures=TeX}
\setmainfont[BoldFont={Fira Sans}]{Fira Sans Light}
\setmonofont{Fira Mono}
\newfontfamily\liningfont[Numbers={Lining}]{Fira Sans Light}

% Math fonts
\setmathfont{FiraMath-Regular.otf}
\setmathfont[range=up, math-style=ISO]{Fira Mono}[Scale=MatchLowercase]
\setmathfont[range=it, math-style=ISO]{Fira Mono}[Scale=MatchLowercase]
\setmathfont[range=bfup, math-style=ISO]{Fira Mono}[Scale=MatchLowercase]
\setmathfont[range=bfit, math-style=ISO]{Fira Mono}[Scale=MatchLowercase]
\setmathfont[range={"22C8}]{Latin Modern Math} % Fallback for missing symbols

% ============================================================================
% Spacing configuration
% ============================================================================

% ============================================================================
% Hyperlink setup
% ============================================================================
\hypersetup{
  colorlinks=true,
  linkcolor=materialOrangeText,
  menucolor=materialOrangeText,
  urlcolor=materialOrangeText
}

% ============================================================================
% Table of contents styling
% ============================================================================
\titlecontents{section}
  [1.5em]
  {}
  {\contentslabel{1.5em}}
  {\hspace*{-1.5em}}
  {\titlerule*[0.8em]{.}\contentspage}

\titlecontents{subsection}
  [3.8em]
  {}
  {\contentslabel{2.3em}}
  {\hspace*{-2.3em}}
  {\titlerule*[0.8em]{.}\contentspage}

% ============================================================================
% Section formatting
% ============================================================================
\titleformat{\section}
  {\Large\bfseries\scshape}
  {\thesection}{0.5em}{}
\titleformat{\subsection}
  {\large\bfseries\scshape}
  {\thesubsection}{0.5em}{}

% ============================================================================
% List formatting
% ============================================================================
\setlist[itemize]{noitemsep}
\setlist[enumerate]{noitemsep}

% ============================================================================
% Code listings
% ============================================================================
\lstset{
  basicstyle=\liningfont\ttfamily,
  keywordstyle=\color{materialOrangeText}\bfseries,
  commentstyle=\color{materialGreenText},
  stringstyle=\color{materialGreenText},
  numbers=none,
  showspaces=false,
  showstringspaces=false,
  showtabs=false,
  frame=single,
  rulecolor=\color{materialGrey},
  framesep=10pt,
  tabsize=2,
  captionpos=b,
  breaklines=true,
  breakatwhitespace=false,
  aboveskip=0.5em,
  belowskip=0.5em,
  xleftmargin=1.2em,
  xrightmargin=1.2em
}

% ============================================================================
% Custom commands
% ============================================================================

% Custom option description command
\newcommand{\DescribeOption}[4]{
  \medskip\noindent
  \texttt{\textbf{#1}}
  \begin{quote}
    \textit{\textbf{\textcolor{materialGreenText}{#2}}}\dotfill\,#3\par
    \vspace{0.5em}#4\par
  \end{quote}
}

% Material Design Box Generator
% Usage: \definematerialbox{stylename}{Title}{color}
% Example: \definematerialbox{answerstyle}{Answer}{materialIndigo}
\newcommand{\definematerialbox}[3]{%
  \mdfdefinestyle{#1}{%
    backgroundcolor=#3!20,
    linecolor=#3!60,
    linewidth=1pt,
    innertopmargin=1em,
    innerbottommargin=1em,
    skipabove=0.5em,
    skipbelow=0.5em,
    frametitle={#2},
    frametitlebackgroundcolor=#3!30,
    % The title is the box colour mixed with 45% black, so it reads on the tint.
    frametitlefont=\bfseries\color{#3!55!black},
  }%
}

\endinput
